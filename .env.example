# PostgreSQL connection string
DATABASE_URL="postgresql://myspotify:myspotify@localhost:5432/myspotify"
POSTGRES_USER="myspotify"
POSTGRES_PASSWORD="myspotify"
POSTGRES_DB="myspotify"
POSTGRES_PORT="5432"

# Backend API server
PORT="3001"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Comma-separated absolute paths to auto-register and scan on API startup (optional)
# Example: MUSIC_LIBRARY_DIRS="/Users/yourname/Music,/mnt/nas/flac"
MUSIC_LIBRARY_DIRS=""

# Starting directory for the server-side folder browser (defaults to user home directory)
LIBRARY_BROWSE_ROOT=""

# Watch registered library folders for live file additions/removals
ENABLE_FOLDER_WATCH="true"
